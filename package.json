{
  "name": "@loontail/minecraft-kit",
  "version": "0.9.0",
  "description": "Stateless TypeScript Minecraft launcher library and interactive CLI for vanilla, Fabric, and Forge.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loontail/minecraft-kit.git"
  },
  "homepage": "https://loontail.github.io/minecraft-kit/",
  "bugs": {
    "url": "https://github.com/loontail/minecraft-kit/issues"
  },
  "keywords": [
    "minecraft",
    "minecraft-launcher",
    "launcher",
    "fabric",
    "forge",
    "mojang",
    "java-runtime",
    "microsoft-oauth",
    "mckit"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mckit": "./dist/cli/index.mjs"
  },
  "files": [
    "dist/index.mjs",
    "dist/index.cjs",
    "dist/index.d.ts",
    "dist/index.d.cts",
    "dist/cli/index.mjs",
    "dist/cli/index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check ./src ./tests",
    "lint:fix": "biome check --write ./src ./tests",
    "format": "biome format --write ./src ./tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:api": "typedoc",
    "docs:dev": "npm run docs:api && vitepress dev docs-site",
    "docs:build": "npm run docs:api && vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "prepare": "husky"
  },
  "dependencies": {
    "lru-cache": "^11.5.2",
    "p-limit": "^7.3.1",
    "yauzl": "^3.4.0"
  },
  "optionalDependencies": {
    "@clack/prompts": "^1.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^22.12.0",
    "@types/yauzl": "^3.4.0",
    "@vitest/coverage-v8": "^1.6.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "tsup": "^8.5.1",
    "typedoc": "~0.28.20",
    "typedoc-plugin-markdown": "~4.12.0",
    "typedoc-vitepress-theme": "~1.1.3",
    "typescript": "~5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^1.6.1"
  }
}
